<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="PolyhydraBaGet" value="https://nuget.polyhydragames.com/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Observation.Core and PolyhydraGames.CaptionExtractor are restored only from the internal
       feed; everything else only from nuget.org. CaptionExtractor isn't published there yet (see
       SmartTVRelay.Core.csproj's transitional ProjectReference), so this mapping is prepared
       ahead of that; the only change needed once it is published is swapping the
       ProjectReference for a PackageReference. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="PolyhydraBaGet">
      <package pattern="Observation.Core" />
      <package pattern="PolyhydraGames.CaptionExtractor" />
    </packageSource>
  </packageSourceMapping>
</configuration>
