<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="PolyhydraBaGet" value="https://nuget.polyhydragames.com/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Observation.Core is restored only from the internal feed; everything else only from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="PolyhydraBaGet">
      <package pattern="Observation.Core" />
    </packageSource>
  </packageSourceMapping>
</configuration>
